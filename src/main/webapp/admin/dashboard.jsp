<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Admin - CoffeePoly</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><nav class="nav"><a class="brand" href="${pageContext.request.contextPath}/">CoffeePoly Admin</a><div class="navlinks"><a href="${pageContext.request.contextPath}/">Website</a><a href="${pageContext.request.contextPath}/logout">Đăng xuất</a></div></nav>
<main class="container"><h1>Quản trị CoffeePoly</h1><section class="panel"><h2>Thêm sản phẩm</h2><form method="post" action="${pageContext.request.contextPath}/admin" class="grid"><input type="hidden" name="action" value="add"><div><label>Danh mục ID</label><input type="number" name="categoryId" min="1" required></div><div><label>Tên sản phẩm</label><input name="name" required></div><div><label>Giá (VND)</label><input type="number" name="price" min="0" step="1000" required></div><div><label>Số lượng kho</label><input type="number" name="stock" min="0" value="100" required></div><div style="grid-column:1/-1"><label>Mô tả</label><input name="description"></div><div><button class="btn">Thêm sản phẩm</button></div></form></section>
<section style="margin-top:35px"><h2>Quản lý sản phẩm</h2><div class="panel"><table><tr><th>ID</th><th>Tên</th><th>Giá</th><th>Tồn kho</th><th></th></tr><c:forEach var="p" items="${products}"><tr><td>${p.productId}</td><td><c:out value="${p.productName}"/></td><td>${p.price}</td><td>${p.stock}</td><td><form method="post" action="${pageContext.request.contextPath}/admin"><input type="hidden" name="action" value="delete"><input type="hidden" name="productId" value="${p.productId}"><button class="btn danger small" data-confirm="Ẩn sản phẩm này?">Ẩn</button></form></td></tr></c:forEach></table></div></section>
<section style="margin-top:35px"><h2>Quản lý đơn hàng</h2><div class="panel"><table><tr><th>Mã</th><th>Khách hàng</th><th>Người nhận</th><th>Điện thoại</th><th>Địa chỉ</th><th>Tổng</th><th>Trạng thái</th><th>Cập nhật</th></tr><c:forEach var="o" items="${orders}"><tr><td>#${o.id}</td><td><c:out value="${o.customer}"/></td><td><c:out value="${o.receiver}"/></td><td>${o.phone}</td><td><c:out value="${o.address}"/></td><td>${o.total} đ</td><td>${o.status}</td><td><form method="post" action="${pageContext.request.contextPath}/admin"><input type="hidden" name="action" value="status"><input type="hidden" name="orderId" value="${o.id}"><select name="status"><option>Chờ xác nhận</option><option>Đang chuẩn bị</option><option>Đang giao</option><option>Đã giao</option><option>Đã hủy</option></select><button class="btn small">Lưu</button></form></td></tr></c:forEach></table><c:if test="${empty orders}"><p>Chưa có đơn hàng.</p></c:if></div></section></main><script src="${pageContext.request.contextPath}/js/main.js"></script></body></html>
