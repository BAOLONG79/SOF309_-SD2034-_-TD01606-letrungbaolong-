<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Menu - CoffeePoly</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body>
<nav class="nav"><a class="brand" href="${pageContext.request.contextPath}/">CoffeePoly</a><div class="navlinks"><a href="${pageContext.request.contextPath}/">Trang chủ</a><a href="${pageContext.request.contextPath}/products">Menu</a><a href="${pageContext.request.contextPath}/cart">Giỏ hàng</a><a href="${pageContext.request.contextPath}/login">Tài khoản</a></div></nav>
<main class="container"><h1>Menu CoffeePoly</h1><p class="muted">Chọn thức uống bạn yêu thích.</p>
<form method="get" action="${pageContext.request.contextPath}/products" style="display:flex;gap:10px;max-width:600px"><input name="q" value="${keyword}" placeholder="Tìm tên cà phê..." style="margin:0"><button class="btn">Tìm kiếm</button></form>
<div class="grid" style="margin-top:25px"><c:forEach var="p" items="${products}"><article class="product"><div class="photo">COFFEE</div><div class="body"><h3><c:out value="${p.productName}"/></h3><p class="muted"><c:out value="${p.description}"/></p><p class="price"><c:out value="${p.price}"/> đ</p><form method="post" action="${pageContext.request.contextPath}/cart"><input type="hidden" name="action" value="add"><input type="hidden" name="productId" value="${p.productId}"><button class="btn">Thêm vào giỏ</button></form></div></article></c:forEach></div>
<c:if test="${empty products}"><p>Không tìm thấy sản phẩm phù hợp.</p></c:if></main><footer class="footer">© CoffeePoly</footer></body></html>
