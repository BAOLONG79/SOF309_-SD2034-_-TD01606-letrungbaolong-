<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ page import="com.coffeepoly.model.CartItem,java.util.*,java.math.BigDecimal" %>
<%
Map<Integer,CartItem> cart=(Map<Integer,CartItem>)session.getAttribute("cart");
BigDecimal total=BigDecimal.ZERO;if(cart!=null)for(CartItem i:cart.values())total=total.add(i.getSubtotal());
%>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Giỏ hàng - CoffeePoly</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><nav class="nav"><a class="brand" href="${pageContext.request.contextPath}/">CoffeePoly</a><div class="navlinks"><a href="${pageContext.request.contextPath}/products">Tiếp tục mua hàng</a></div></nav>
<main class="container"><h1>Giỏ hàng của bạn</h1><c:choose><c:when test="${empty cartItems}"><div class="panel"><p>Giỏ hàng đang trống.</p><a class="btn" href="${pageContext.request.contextPath}/products">Xem menu</a></div></c:when><c:otherwise><div class="panel"><table><tr><th>Sản phẩm</th><th>Đơn giá</th><th>Số lượng</th><th>Tạm tính</th><th></th></tr><c:forEach var="item" items="${cartItems}"><tr><td><c:out value="${item.product.productName}"/></td><td>${item.product.price} đ</td><td><form method="post" action="${pageContext.request.contextPath}/cart" style="display:flex;gap:5px;margin:0"><input type="hidden" name="action" value="update"><input type="hidden" name="productId" value="${item.product.productId}"><input type="number" name="quantity" min="0" max="99" value="${item.quantity}" style="width:75px;margin:0"><button class="btn small">Cập nhật</button></form></td><td>${item.subtotal} đ</td><td><form method="post" action="${pageContext.request.contextPath}/cart"><input type="hidden" name="action" value="remove"><input type="hidden" name="productId" value="${item.product.productId}"><button class="btn danger small">Xóa</button></form></td></tr></c:forEach></table><h2 style="text-align:right">Tổng: <%=total%> đ</h2><div style="text-align:right"><a class="btn" href="${pageContext.request.contextPath}/checkout">Tiến hành thanh toán</a></div></div></c:otherwise></c:choose></main></body></html>
