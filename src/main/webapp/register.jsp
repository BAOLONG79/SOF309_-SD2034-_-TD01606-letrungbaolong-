<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Đăng ký - CoffeePoly</title><link rel="stylesheet" href="<%=request.getContextPath()%>/css/style.css"></head><body><nav class="nav"><a class="brand" href="<%=request.getContextPath()%>/">CoffeePoly</a><a href="<%=request.getContextPath()%>/products">Menu</a></nav>
<main class="container"><form class="panel form" method="post" action="<%=request.getContextPath()%>/register"><h2>Tạo tài khoản</h2><%if(request.getAttribute("error")!=null){%><div class="error"><%=request.getAttribute("error")%></div><%}%>
<label>Họ và tên</label><input name="fullName" required maxlength="100"><label>Email</label><input type="email" name="email" required maxlength="100"><label>Số điện thoại</label><input name="phone" required maxlength="20"><label>Mật khẩu (ít nhất 6 ký tự)</label><input type="password" name="password" required minlength="6"><label>Nhập lại mật khẩu</label><input type="password" name="confirmPassword" required><button class="btn" style="width:100%">Đăng ký</button><p class="muted">Đã có tài khoản? <a href="<%=request.getContextPath()%>/login">Đăng nhập</a></p></form></main></body></html>
